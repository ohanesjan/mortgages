import requests
from bs4 import BeautifulSoup
import csv
import pandas as pd

# %%

   
URL = "http://www.values.com/inspirational-quotes"
r = requests.get(URL)
   
soup = BeautifulSoup(r.content, 'html5lib')
# %%

# print(soup.prettify())
bucket = soup.find('div', attrs= {'id' : 'all_quotes'})
items_list = bucket.find_all('div', class_ = "col-6 col-lg-4 text-center margin-30px-bottom sm-margin-30px-top")

