#     quote['author'] = row.img['alt'].split(" #")[1]

quotes = {'theme' : [],
          'url' :  [],
        #   'img' : [],
          'lines' : [],
          'author' : []
          }

print(items_list[2].img['alt'].split(" #")[1])

for item in items_list:

    quotes['theme'].append(item.h5.text)
    quotes['url'].append(item.a['href'])
    quotes['lines'].append(item.img['alt'].split(' #')[0])
    quotes['author'].append(item.img['alt'].split(' #')[1])

quotes_df = pd.DataFrame(quotes)
